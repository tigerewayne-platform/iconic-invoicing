# Postgres connection string (Neon / Vercel Postgres / Supabase all work)
DATABASE_URL=postgres://user:password@host:5432/iconic

# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this app, used in emails and client share links
APP_URL=https://billing.iconicstretchtents.co.za

# Optional: Resend API key to email PDFs straight from the app
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="Iconic Stretch Tents <accounts@iconicstretchtents.co.za>"
